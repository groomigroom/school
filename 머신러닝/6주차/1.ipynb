w = tf.Variable(4.0)
b = tf.Variable(1.0)
@tf.function
def hypothesis(x):
    return w*x + b

x_test = [3.5, 5, 5.5, 6]
print(hypothesis(x_test).numpy())
#[15. 21. 23. 25.]

