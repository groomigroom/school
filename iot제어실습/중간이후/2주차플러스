## 3. Microchip Studio 전체 소스코드

다음 코드를 `main.c`에 넣으면 돼.

```

#define F_CPU 16000000UL

#include <avr/io.h>
#include <avr/interrupt.h>
#include <util/delay.h>
#include <stdint.h>

// =================================
// 전역 변수
// =================================

volatile uint16_t adc_value = 0;

volatile uint8_t fnd_digit[4] = {0, 0, 0, 0};

volatile uint8_t scan_index = 0;

// 7-Segment 숫자 패턴
// Common Cathode 기준
// PA0=a, PA1=b, PA2=c, PA3=d
// PA4=e, PA5=f, PA6=g, PA7=DP

const uint8_t fnd_pattern[10] = {
    0x3F, // 0
    0x06, // 1
    0x5B, // 2
    0x4F, // 3
    0x66, // 4
    0x6D, // 5
    0x7D, // 6
    0x07, // 7
    0x7F, // 8
    0x6F  // 9
};

// =================================
// ADC 초기화
// =================================

void ADC_Init(void)
{
    // ADC0(PF0) 입력
    DDRF &= ~(1 << PF0);

    // AVCC 기준전압 사용
    ADMUX = (1 << REFS0);

    // ADC 활성화
    // 분주비 128
    ADCSRA = (1 << ADEN) |
             (1 << ADPS2) |
             (1 << ADPS1) |
             (1 << ADPS0);
}

// ADC 값 읽기
uint16_t ADC_Read(void)
{
    ADCSRA |= (1 << ADSC);

    while (ADCSRA & (1 << ADSC));

    return ADC;
}

// =================================
// Timer0 초기화
// 1ms 주기 인터럽트
// =================================

void Timer_Init(void)
{
    // CTC 모드
    TCCR0 = (1 << WGM01);

    // 16MHz / 64 / (249+1)
    OCR0 = 249;

    // 분주비 64
    TCCR0 |= (1 << CS01) | (1 << CS00);

    // Timer0 비교일치 인터럽트 허용
    TIMSK |= (1 << OCIE0);
}

// =================================
// FND 출력값 분리
// =================================

void FND_Update(uint16_t value)
{
    fnd_digit[0] = value / 1000;
    fnd_digit[1] = (value / 100) % 10;
    fnd_digit[2] = (value / 10) % 10;
    fnd_digit[3] = value % 10;
}

// =================================
// LED 게이지 출력
// =================================

void LED_Gauge(uint16_t value)
{
    uint8_t level;

    // ADC 0~1023을 LED 0~8개로 변환
    level = (value * 8UL) / 1024;

    // 8개 LED 점등 패턴
    if (level == 0)
    {
        PORTB = 0x00;
    }
    else
    {
        PORTB = (1 << level) - 1;
    }
}

// =================================
// Timer0 비교일치 인터럽트
// 1ms마다 실행
// =================================

ISR(TIMER0_COMP_vect)
{
    // 모든 FND 자리 끄기
    PORTC |= 0x0F;

    // 현재 숫자 출력
    PORTA = fnd_pattern[fnd_digit[scan_index]];

    // 해당 자리만 ON
    PORTC &= ~(1 << scan_index);

    // 다음 자리로 이동
    scan_index++;

    if (scan_index >= 4)
    {
        scan_index = 0;
    }
}

// =================================
// 메인 함수
// =================================

int main(void)
{
    uint16_t sensor_value;

    // FND 출력 설정
    DDRA = 0xFF;

    // FND 자리 선택 출력
    DDRC |= 0x0F;

    // LED 출력 설정
    DDRB = 0xFF;

    // 초기 출력 OFF
    PORTA = 0x00;
    PORTB = 0x00;
    PORTC = 0x0F;

    // ADC 초기화
    ADC_Init();

    // Timer 초기화
    Timer_Init();

    // 전역 인터럽트 허용
    sei();

    while (1)
    {
        // 조도센서 ADC 값 읽기
        sensor_value = ADC_Read();

        // FND에 출력할 값 업데이트
        FND_Update(sensor_value);

        // LED 게이지 출력
        LED_Gauge(sensor_value);

        // 약 50ms 간격으로 측정
        _delay_ms(50);
    }

    return 0;
}

```

## 4. 기능별 동작 원리

① 타이머 인터럽트로 FND 출력

Timer0을 CTC 모드로 설정하고 1ms마다 인터럽트가 발생하도록 했어.

- 1ms마다 첫 번째 FND 출력
- 다음 1ms마다 두 번째 FND 출력
- 세 번째, 네 번째 FND 순서대로 출력
- 반복해서 4자리 숫자가 동시에 켜져 있는 것처럼 보임

타이머 계산식은 다음과 같아.

\\[ \frac{16,000,000}{64 \times (249+1)} =1000Hz \\]

따라서 인터럽트는 1초에 1000번 발생해.

② 조도센서 ADC 값 측정

ATmega128A의 ADC는 10비트이기 때문에 측정값은 0\~1023 범위야.

| ADC 값 | 의미        |
| ----- | --------- |
| 0     | 낮은 ADC 전압 |
| 256   | 약 25%     |
| 512   | 약 50%     |
| 768   | 약 75%     |
| 1023  | 최대 ADC 전압 |

③ LED 게이지 출력

ADC 값에 따라 LED가 0\~8개까지 순차적으로 켜져.

| ADC 범위    | LED 점등 개수 |
| --------- | --------- |
| 0\~127    | 0개        |
| 128\~255  | 1개        |
| 256\~383  | 2개        |
| 384\~511  | 3개        |
| 512\~639  | 4개        |
| 640\~767  | 5개        |
| 768\~895  | 6개        |
| 896\~1023 | 7\~8개     |

참고로 조도센서 회로의 저항 배치에 따라 밝을수록 ADC 값이 커질 수도 있고 작아질 수도 있어. 위 코드는 ADC 값이 커질수록 LED가 많이 켜지는 방식이야.

## 5. 실제 제작 전 확인할 사항



중요

&#x20;위 코드는 지정한 핀 연결과 FND 구동 방식에 맞춘 코드야. 실제 회로에 따라 수정이 필요할 수 있어.



- FND가 공통 애노드라면 숫자 패턴과 자리 선택 논리를 반대로 변경해야 해.
- FND 각 세그먼트에는 전류 제한 저항이 필요해.
- LED에도 전류 제한 저항을 연결해야 해.
- FND 자릿수 구동 전류가 부족하면 트랜지스터 구동 회로가 필요해.
- 조도센서는 반드시 전압 분배 회로로 연결해야 해.

