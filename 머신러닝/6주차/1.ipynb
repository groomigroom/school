w = tf.Variable(2.)

def f(w):
    y = w**2
    z = 2*y + 5
    return z

with tf.GradientTape() as tape:
    z = f(w)

gradients = tape.gradient(z, [w])
#이게 자동으로 미분을 수행하는 함수이다.
print(gradients)

#[<tf.Tensor: shape=(), dtype=float32, numpy=8.0>]

