import numpy as np
import matplotlib.pyplot as plt

def step_function(x):
    return 2 * (x**2) + 5

#4x

xx = np.arange(-5, 5, 0.1)
yy = step_function(xx)

plt.plot(xx, yy)

#접선의 방정식 2에서의 
