import numpy as np
import matplotlib.pyplot as plt

def step_function(x):
    return 3 * (x**2 * x) + 4 * (x**2) + 2 * x + 5

#위에 함수 2일 때 49다
#9x2 + 8x + 2 미분시에
#2일 때 기울기 54

xx = np.arange(-5, 5, 0.1)
yy = step_function(xx)

plt.plot(xx, yy)

#접선의 방정식 2에서의 
def step_function(x):
    return 54 * x - 54

xxx = np.arange(-5, 5, 0.1)
yyy = step_function(xxx)

plt.plot(xxx, yyy)
plt.show()

