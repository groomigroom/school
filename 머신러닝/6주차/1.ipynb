import numpy as np
import matplotlib.pyplot as plt

def step_function(x):
    return 2 * (x**2) + 5

xx = np.arange(-5, 5, 0.1)
yy = step_function(xx)

plt.plot(xx, yy)

#접선의 방정식 2에서의 
def step_function(x):
    return 8 * x - 3

xxx = np.arange(-5, 5, 0.1)
yyy = step_function(xxx)

plt.plot(xxx, yyy)
plt.show()

