import numpy as np
import matplotlib.pyplot as plt

def step_function(x):
    return 2 * (x**2) + 5

#4x

xx = np.arange(-5, 5, 0.1)
yy = step_function(xx)

plt.plot(xx, yy)

#접선의 방정식 2에서의 
def step_function(x):
    return 8 * x - 3

xxx = np.arange(-5, 5, 0.1)
yyy = step_function(xxx)

plt.plot(xxx, yyy)

#접선의 방정식 1에서의
def step_function1(x):
    return 4 * x + 3
#2 * (x**2) + 5 => 7

xx1 = np.arange(-5, 5, 0.1)
yy1 = step_function1(xx1)

plt.plot(xx1, yy1)

#접선의 방정식 3에서의
def step_function3(x):
    return 12 * x - 13
#2 * (x**2) + 5 => 23
#12*3-13

xx3 = np.arange(-5, 5, 0.1)
yy3 = step_function3(xx3)

plt.plot(xx3, yy3)


plt.show()
