import numpy as np
import matplotlib.pyplot as plt
from IPython.display import clear_output  # 💡 코랩 화면 제어를 위한 모듈
import time

# 원래 곡선 함수
def step_function(x):
    return 2 * (x**2) + 5

xx = np.arange(-5, 5, 0.1)
yy = step_function(xx)

# 리스트에 접선 함수들을 차례대로 담아둡니다 (반복문으로 깔끔하게 처리하기 위함)
tangent_functions = [
    ("0.5", lambda x: 2 * x + 4.5),
    ("-0.5", lambda x: -2 * x + 4.5),
    ("1.5", lambda x: 6 * x + 0.5),
    ("-1.5", lambda x: -6 * x + 0.5),
    ("2.5", lambda x: 10 * x - 7.5),
    ("-2.5", lambda x: -10 * x - 7.5),
    ("3.5", lambda x: 14 * x - 19.5),
    ("-3.5", lambda x: -14 * x - 19.5),
    ("4.5", lambda x: 18 * x - 35.5),
    ("-4.5", lambda x: -18 * x - 35.5),
    ("1", lambda x: 4 * x + 3),
    ("2", lambda x: 8 * x - 3),
    ("3", lambda x: 12 * x - 13),
    ("4", lambda x: 16 * x - 27),
    ("5", lambda x: 20 * x - 45),
    ("0", lambda x: 0 * x + 5),
    ("-1", lambda x: -4 * x + 3),
    ("-2", lambda x: -8 * x - 3),
    ("-3", lambda x: -12 * x - 13),
    ("-4", lambda x: -16 * x - 27),
    ("-5", lambda x: -20 * x - 45)
]

# 이미 그려진 y값들을 저장할 리스트
drawn_lines = []

# 첫 화면: 곡선만 먼저 그리기
fig, ax = plt.subplots(figsize=(8, 6))
ax.plot(xx, yy, color="black", linewidth=2.5, label="f(x) = 2x^2 + 5")
ax.grid(True)
ax.set_ylim(-10, 60) # y축 범위를 고정해야 그래프가 출렁거리지 않습니다.
plt.show()
time.sleep(1.0)

# 접선들을 하나씩 추가하며 화면 갱신
for name, func in tangent_functions:
    # 1. 현재 접선의 y값 계산 후 저장
    drawn_lines.append(func(xx))
    
    # 2. 💡 이전 코랩 출력 화면을 깨끗하게 지웁니다.
    clear_output(wait=True)
    
    # 3. 처음부터 다시 새로 그립니다. (곡선 + 지금까지 누적된 접선들)
    fig, ax = plt.subplots(figsize=(8, 6))
    ax.plot(xx, yy, color="black", linewidth=2.5) # 원래 곡선
    
    for line_yy in drawn_lines:
        ax.plot(xx, line_yy, alpha=0.6) # 누적된 접선들 그리기 (alpha로 투명도 조절)
        
    ax.grid(True)
    ax.set_ylim(-10, 60) # Y축 범위 고정
    ax.set_title(f"Added tangent line at x = {name}")
    
    plt.show()
    time.sleep(0.3) # 0.3초 대기 (원하는 속도로 조절 가능)
