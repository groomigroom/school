#히스토그램 만들기
mpg["ratio"] = (mpg["asian"] / mpg["total"] * 100)
mpg["ratio"].plot.hist()

-=-------------------------------------

#전체 평균 구하기
ratio_mean = mpg["ratio"].mean()
ratio_mean


-=-------------------------------------


import numpy as np
mpg["ratio_grade"] = np.where(mpg["ratio"] >= ratio_mean, "pass", "nopass")
mpg


